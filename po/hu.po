#: prefs.js:182 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:80
msgid "A fixed order prevents values from changing places."
msgstr "Fix sorrendnél nem ugrálnak az értékek egymás helyére."

#: prefs.js:214 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:94
msgid ""
"A hard disk is hot from this temperature. Default: 50; many drives specify "
"60 °C as their maximum."
msgstr ""
"A merevlemez ettől számít forrónak. Alapértelmezés: 50; sok meghajtó 60 °C-"
"os maximumot ad meg."

#: prefs.js:204 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:178
msgid "Alert threshold for any hard disk. Default: 50. 0 disables the alert."
msgstr ""
"Bármely merevlemez riasztási küszöbe. Alapértelmezés: 50. A 0 kikapcsolja a "
"riasztást."

#: prefs.js:202 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:177
msgid "Alert: HDD (°C)"
msgstr "Riasztás: HDD (°C)"

#: prefs.js:198 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:170
msgid "Alert: system temperature (°C)"
msgstr "Riasztás: rendszerhőfok (°C)"

#: prefs.js:147
msgid "All disk temperatures"
msgstr "Minden diszk hőfoka"

#: prefs.js:136
msgid "Center"
msgstr "Közép"

#: prefs.js:239 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:140
msgid ""
"Color used above the hot threshold. Alerts and the alert icon use it too."
msgstr ""
"A forró küszöb fölötti szín. A riasztási sor és a riasztó ikon is ezt "
"használja."

#: prefs.js:235 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:128
msgid "Color used below the warm threshold."
msgstr "A meleg küszöb alatti hőfokok színe."

#: prefs.js:237 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:134
msgid "Color used between the warm and hot thresholds."
msgstr "A meleg és a forró küszöb közötti szín."

#: prefs.js:241 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:146
msgid "Color used when a reading failed (n/a) or no data is available yet."
msgstr "A sikertelen olvasás (n/a), illetve a még nem elérhető adat színe."

#: prefs.js:232
msgid "Colors"
msgstr "Színek"

#: prefs.js:234 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:127
msgid "Cool"
msgstr "Hideg"

#: prefs.js:190 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:151
msgid "Dark drop-down menu"
msgstr "Sötét lenyíló menü"

#: prefs.js:200 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:171
msgid ""
"Default: 44. The indicator turns warm 3 °C earlier. Sensor placement depends "
"on the motherboard, so adjust this value for the machine if necessary. 0 "
"disables the alert."
msgstr ""
"Alapértelmezés: 44. A kijelzés 3 °C-kal korábban sárgára vált. A szenzor "
"helye alaplapfüggő, ezért szükség esetén igazítsd az értéket a géphez. A 0 "
"kikapcsolja a riasztást."

#: prefs.js:210 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:87
msgid ""
"Default: 45. Provides an early warning before the 50 °C normal-range "
"boundary."
msgstr ""
"Alapértelmezés: 45. Korai figyelmeztetés az 50 °C-os normál tartományhatár "
"előtt."

#: prefs.js:218 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:101
msgid ""
"Default: 55. SATA SSDs commonly specify 70 °C as their upper operating "
"temperature."
msgstr ""
"Alapértelmezés: 55. A SATA SSD-k felső üzemi hőmérséklete jellemzően 70 °C."

#: prefs.js:226 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:115
msgid ""
"Default: 60. Provides an early warning before the 70 °C operating limit."
msgstr "Alapértelmezés: 60. Korai figyelmeztetés a 70 °C-os üzemi határ előtt."

#: prefs.js:222 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:108
msgid ""
"Default: 65. Sustained operation above this point calls for better cooling."
msgstr ""
"Alapértelmezés: 65. Az e fölötti tartós működésnél javítani kell a hűtést."

#: prefs.js:230 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:122
msgid ""
"Default: 70. This is a common upper operating limit and NVMe warning point."
msgstr ""
"Alapértelmezés: 70. Ez egy gyakori felső üzemi határ és NVMe figyelmeztetési "
"pont."

#: prefs.js:159 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:55
msgid "Device label in panel"
msgstr "Eszközcímke a panelen"

#: prefs.js:179
msgid "Device name (fixed)"
msgstr "Eszköznév (fix)"

#: extension.js:93
msgid "Disk Temperatures"
msgstr "Lemezhőmérsékletek"

#: prefs.js:212 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:93
msgid "HDD hot (°C)"
msgstr "HDD forró (°C)"

#: prefs.js:208 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:86
msgid "HDD warm (°C)"
msgstr "HDD meleg (°C)"

#: prefs.js:238 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:139
msgid "Hot"
msgstr "Forró"

#: prefs.js:180
msgid "Hottest first"
msgstr "Legmelegebb elöl"

#: prefs.js:148
msgid "Hottest only"
msgstr "Csak a legmelegebb"

#: prefs.js:125 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:30
msgid "Language"
msgstr "Nyelv"

#: prefs.js:131 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:31
msgid "Language used by this extension. Changes apply immediately."
msgstr "Az extension által használt nyelv. A módosítás azonnal érvénybe lép."

#: prefs.js:135
msgid "Left"
msgstr "Bal"

#: prefs.js:228 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:121
msgid "NVMe hot (°C)"
msgstr "NVMe forró (°C)"

#: prefs.js:224 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:114
msgid "NVMe warm (°C)"
msgstr "NVMe meleg (°C)"

#: extension.js:965
msgid "NVMe: read failed"
msgstr "NVMe: sikertelen olvasás"

#: prefs.js:169 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:73
msgid "Only warm or hotter disks"
msgstr "Csak a meleg vagy forróbb diszkek"

#: prefs.js:145 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:49
msgid "Panel content"
msgstr "Panel tartalma"

#: prefs.js:177 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:79
msgid "Panel order"
msgstr "Panel sorrendje"

#: prefs.js:133 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:36
msgid "Panel position"
msgstr "Panel helye"

#: prefs.js:141 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:43
msgid "Position in section"
msgstr "Pozíció a panelrészen belül"

#: prefs.js:184 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:184
msgid "Refresh interval (seconds)"
msgstr "Frissítési időköz (másodperc)"

#: prefs.js:137
msgid "Right"
msgstr "Jobb"

#: prefs.js:220 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:107
msgid "SATA SSD hot (°C)"
msgstr "SATA SSD forró (°C)"

#: prefs.js:216 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:100
msgid "SATA SSD warm (°C)"
msgstr "SATA SSD meleg (°C)"

#: prefs.js:186 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:185
msgid "SMART reading interval. Default: 5."
msgstr "A SMART-olvasás gyakorisága. Alapértelmezés: 5."

#: extension.js:1027
msgid "STOPPED"
msgstr "ÁLL"

#: extension.js:171
msgid "Settings…"
msgstr "Beállítások…"

#: prefs.js:165 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:68
msgid "Show an HDD, SSD, or NVMe label next to the temperature: “sdb HDD 54°”."
msgstr "HDD, SSD vagy NVMe címke megjelenítése a hőfok mellett: „sdb HDD 54°”."

#: prefs.js:155 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:62
msgid ""
"Show an icon before the temperatures. Its color follows the most severe disk "
"state."
msgstr ""
"Ikon megjelenítése a hőfokok előtt. A színe a legsúlyosabb lemezállapotot "
"követi."

#: prefs.js:164 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:67
msgid "Show disk type"
msgstr "Diszktípus megjelenítése"

#: prefs.js:170 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:74
msgid ""
"Show only disks at or above their warm threshold and disks with read errors. "
"When all disks are cool, show “OK 32°”. The menu still shows every disk."
msgstr ""
"Csak a meleg küszöböt elért diszkek és a hibás olvasások jelenjenek meg. Ha "
"minden diszk hideg, „OK 32°” látszik. A menü továbbra is minden diszket "
"megjelenít."

#: prefs.js:175 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:158
msgid ""
"Show the detected SYSTIN, System, Motherboard, or Ambient hwmon sensor after "
"the icon, using its own name. Disk filtering does not hide it."
msgstr ""
"A felismert SYSTIN, System, Motherboard vagy Ambient hwmon szenzor jelenjen "
"meg az ikon után, a saját nevével. A diszkszűrés nem rejti el."

#: prefs.js:196 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:164
msgid ""
"Show the detected system temperature and measurable fans from the same "
"motherboard hwmon device. A fan is monitored after it has reported a "
"positive speed."
msgstr ""
"A felismert rendszerhőfok és az ugyanazon alaplapi hwmon eszköz mérhető "
"ventilátorainak megjelenítése. Egy ventilátor figyelése az első pozitív "
"fordulatszám után kezdődik."

#: prefs.js:160 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:56
msgid ""
"Show the device name before its temperature: “sdb 54°” instead of just “54°”."
msgstr ""
"Az eszköznév megjelenítése a hőfok előtt: „sdb 54°” a puszta „54°” helyett."

#: prefs.js:195 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:163
msgid "System sensors in menu"
msgstr "Rendszerszenzorok a menüben"

#: prefs.js:174 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:157
msgid "System temperature in panel"
msgstr "Rendszerhőfok a panelen"

#: prefs.js:150 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:50
msgid "The drop-down menu always shows every detected disk."
msgstr "A lenyíló menü mindig minden felismert diszket megjelenít."

#: prefs.js:139 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:37
msgid "The section of the GNOME panel where the indicator is placed."
msgstr "A GNOME panel azon része, ahová az indikátor kerül."

#: prefs.js:154 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:61
msgid "Thermometer icon"
msgstr "Hőmérő ikon"

#: prefs.js:206
msgid "Thresholds"
msgstr "Küszöbök"

#: prefs.js:240 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:145
msgid "Unknown / read error"
msgstr "Ismeretlen / olvasási hiba"

#: extension.js:164 extension.js:963
msgid "Updated:"
msgstr "Frissítve:"

#: prefs.js:191 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:152
msgid ""
"Use a dark menu background independently of the shell theme. Secondary text "
"can be difficult to read with this disabled on light themes."
msgstr ""
"Sötét menüháttér használata a Shell témájától függetlenül. Világos témákon "
"kikapcsolva a másodlagos szövegek nehezen olvashatók lehetnek."

#: prefs.js:236 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:133
msgid "Warm"
msgstr "Meleg"

#: extension.js:578
msgid "nvme-cli was not found"
msgstr "Az nvme-cli nem található"

#: extension.js:953
msgid "standby"
msgstr "készenlét"

#: extension.js:718
msgid "stopped"
msgstr "leállt"

#: extension.js:696
msgid "system"
msgstr "rendszer"

#: prefs.js:143 schemas/org.gnome.shell.extensions.disk-temps.gschema.xml:44
msgid ""
"−1 places it at the end. In the left section, 0 is the first position after "
"Activities."
msgstr ""
"A −1 a panelrész végére helyezi. A bal oldali részen a 0 az első hely a "
"Tevékenységek után."
